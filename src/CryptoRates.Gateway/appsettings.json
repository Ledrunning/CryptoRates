{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rates": {
    "BaseUrl": "https://api.coingecko.com/api/v3/",
    "PollInterval": "00:10:00",
    "MaxCoins": 250,
    "PinnedCoins": [
      "terrausd",
      "terra-luna"
    ]
  },
  "RateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://crypto-rates.example.com"
    ]
  }
}